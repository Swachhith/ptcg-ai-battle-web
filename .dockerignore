# Only what the game server needs goes into the image (see Dockerfile).
.git
.cache
**/__pycache__
*.pyc

# credentials: Render copies secret files into the build context; never bake them in
kaggle.json
**/kaggle.json
.env*

# not used by the server
agent
battery
docs
native
opponents
ptcg
tools
decks/pool_alt
webapp/web
webapp/tools
webapp/server/card_images

# the PyTorch weights: the browser runs the ONNX export instead
submission/model.pt
submission/*.tar.gz

# competition data present on a developer machine; the build fetches its own copy
data/cg
data/EN_Card_Data.csv
submission/cg
submission/EN_Card_Data.csv
submission/data/EN_Card_Data.csv
